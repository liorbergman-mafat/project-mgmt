# Copy this file to backend/.env and fill in the real values.
# Supabase Dashboard -> Project Settings -> API
#
# SUPABASE_SERVICE_KEY is the `service_role` key, NOT the `anon` key.
# It bypasses Row Level Security, so it must never reach the browser.
# backend/.env is gitignored — keep it that way.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

FRONTEND_ORIGIN=http://localhost:5173
