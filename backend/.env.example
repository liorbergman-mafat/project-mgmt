# Copy this file to backend/.env and fill in the real values.
# Supabase Dashboard -> Project Settings -> API
#
# SUPABASE_SERVICE_KEY is the `service_role` key, NOT the `anon` key.
# It bypasses Row Level Security, so it must never reach the browser.
# backend/.env is gitignored AND listed in .vercelignore — keep it that way.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# The `anon` (public) key from the same page. The backend uses it only to have
# Supabase validate a user's Google sign-in token. It is safe in the frontend
# too (VITE_SUPABASE_ANON_KEY) — it grants no data access on its own.
SUPABASE_ANON_KEY=your-anon-public-key-here

# Comma-separated list of allowed CORS origins. In production add the deployed
# site, e.g. FRONTEND_ORIGIN=http://localhost:5173,https://loan-manager.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Serves the interactive API docs at /docs. Leave false in production.
DEBUG=false
