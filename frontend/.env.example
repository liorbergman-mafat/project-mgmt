# Copy to frontend/.env for local dev (frontend/.env is gitignored).
# On Vercel, set these as Project -> Settings -> Environment Variables instead.
#
# All three are read at BUILD time — after changing one, rebuild / redeploy.

# Backend API base, including the /api suffix. Leave unset locally: the app
# falls back to /api and Vite proxies it to the FastAPI dev server.
# VITE_API_BASE_URL=https://loan-manager.vercel.app/api

# Supabase -> Project Settings -> API. The anon key is public and safe here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
